<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/dj_surface_pressed" />
            <stroke android:width="2dp" android:color="@color/white" />
            <corners android:radius="@dimen/radius_small" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/dj_pad_active" />
            <stroke android:width="1dp" android:color="@color/dj_cyan" />
            <corners android:radius="@dimen/radius_small" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/dj_pad_idle" />
            <stroke android:width="1dp" android:color="@color/dj_border" />
            <corners android:radius="@dimen/radius_small" />
        </shape>
    </item>
</selector>
