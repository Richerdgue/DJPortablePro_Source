<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glowing Orange Outer Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#FF6D00" />
        </shape>
    </item>
    <!-- Metallic Body with 3D Linear Gradient -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#4A5262"
                android:centerColor="#2A303C"
                android:endColor="#181B22"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#FF6D00" />
        </shape>
    </item>
    <!-- Center Glowing Orange Notch -->
    <item android:top="15dp" android:bottom="15dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <solid android:color="#FF6D00" />
        </shape>
    </item>
</layer-list>
