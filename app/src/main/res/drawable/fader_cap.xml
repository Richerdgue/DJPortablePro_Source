<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Beveled Metal Border & Drop Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#5B6476" />
        </shape>
    </item>
    <!-- Metallic Body with 3D Linear Gradient -->
    <item android:top="1.5dp" android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#4A5262"
                android:centerColor="#2A303C"
                android:endColor="#181B22"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#2D3442" />
        </shape>
    </item>
    <!-- Center Tactile White/Cyan Grip Line Notch -->
    <item android:top="15dp" android:bottom="15dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <solid android:color="#00E5FF" />
        </shape>
    </item>
</layer-list>
