<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dj_panel_header"
    android:padding="@dimen/spacing_small">

    <!-- BPM & KEY -->
    <LinearLayout
        android:id="@+id/bpmKeyContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/DjText.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="124.0"
            android:textColor="@color/dj_cyan"
            android:textSize="@dimen/text_huge"
            android:textStyle="bold" />

        <TextView
            style="@style/DjText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4A / C#m"
            android:textColor="@color/dj_text_secondary"
            android:textSize="@dimen/text_micro" />
    </LinearLayout>

    <!-- TITLE & ARTIST -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/timeContainer"
        app:layout_constraintStart_toEndOf="@id/bpmKeyContainer"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/DjText.TrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="TRACK TITLE EXAMPLE"
            android:textColor="@color/dj_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            style="@style/DjText.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ARTIST NAME"
            android:textColor="@color/dj_text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- TIME -->
    <LinearLayout
        android:id="@+id/timeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/DjText.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:45.2"
            android:textColor="@color/dj_cyan"
            android:textSize="@dimen/text_subhead"
            android:textStyle="bold" />

        <TextView
            style="@style/DjText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-01:20.8"
            android:textColor="@color/dj_text_secondary"
            android:textSize="@dimen/text_micro" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
