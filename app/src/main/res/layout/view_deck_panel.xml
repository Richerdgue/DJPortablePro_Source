<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dj_panel_bg"
    android:padding="8dp">

    <!-- JOG WHEEL REDUCIDO (60% de altura, proporción 1:1) -->
    <com.djportablepro.app.ui.deck.JogWheelView
        android:id="@+id/jogWheel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.60"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sideButtonsLayout"
        app:layout_constraintHorizontal_bias="0.5" />

    <!-- VERTICAL SIDE BUTTONS (FX, EQ, LOOP) - Ligeramente más grandes -->
    <LinearLayout
        android:id="@+id/sideButtonsLayout"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="@id/jogWheel"
        app:layout_constraintBottom_toBottomOf="@id/jogWheel"
        app:layout_constraintStart_toEndOf="@id/jogWheel"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- FX Button -->
        <Button
            style="@style/DjButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:text="FX"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- EQ Button -->
        <Button
            style="@style/DjButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:text="EQ"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Third Button (Loop / Circular symbol) -->
        <Button
            style="@style/DjButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="↺"
            android:textSize="20sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
