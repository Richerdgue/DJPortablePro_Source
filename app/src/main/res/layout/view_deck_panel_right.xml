<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deckPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dj_panel_bg"
    android:padding="2dp">

    <!-- VERTICAL SIDE BUTTONS -->
    <LinearLayout
        android:id="@+id/sideButtonsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnFx"
            android:background="@drawable/btn_selector_round"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="FX"
            android:textColor="@color/dj_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEq"
            android:background="@drawable/btn_selector_round"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="EQ"
            android:textColor="@color/dj_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLoop"
            android:background="@drawable/btn_selector_round"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="↺"
            android:textColor="@color/dj_text_primary"
            android:textSize="20sp" />

    </LinearLayout>

    <!-- JOG WHEEL DECK B (Ubicación equilibrada perfecta en el centro horizontal) -->
    <com.djportablepro.app.ui.deck.JogWheelView
        android:id="@+id/jogWheel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.88"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideButtonsLayout"
        app:layout_constraintEnd_toStartOf="@id/pitchControl"
        app:layout_constraintHorizontal_bias="0.42"
        app:layout_constraintVertical_bias="0.52" />

    <!-- PITCH CONTROL EN EL EXTREMO LATERAL DERECHO -->
    <com.djportablepro.app.ui.deck.PitchControlView
        android:id="@+id/pitchControl"
        android:layout_width="52dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/jogWheel"
        app:layout_constraintBottom_toBottomOf="@id/jogWheel"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
