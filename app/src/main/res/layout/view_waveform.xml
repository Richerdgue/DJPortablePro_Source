<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dj_panel_bg">

    <!-- Background Grid / Texture placeholder -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.1"
        android:background="@color/dj_border" />

    <!-- Playhead Center Indicator -->
    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:background="@color/white" />

    <!-- Visual Waveform Placeholder (Top/Bottom symmetrical) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:alpha="0.3"
            android:background="@color/dj_cyan" />

        <Space android:layout_width="match_parent" android:layout_height="2dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:alpha="0.3"
            android:background="@color/dj_cyan" />
    </LinearLayout>

</FrameLayout>
