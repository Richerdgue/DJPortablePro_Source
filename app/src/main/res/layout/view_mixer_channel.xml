<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_small">

    <!-- Knobs Area -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Placeholder Knobs -->
        <View android:layout_width="@dimen/knob_sm" android:layout_height="@dimen/knob_sm" android:layout_margin="@dimen/spacing_tiny" android:background="@color/dj_border_highlight" />
        <TextView style="@style/DjText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GAIN" android:textSize="@dimen/text_micro" android:textColor="@color/dj_text_secondary"/>

        <View android:layout_width="@dimen/knob_md" android:layout_height="@dimen/knob_md" android:layout_margin="@dimen/spacing_tiny" android:background="@color/dj_border_highlight" />
        <TextView style="@style/DjText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HIGH" android:textSize="@dimen/text_micro" android:textColor="@color/dj_text_secondary"/>

        <View android:layout_width="@dimen/knob_md" android:layout_height="@dimen/knob_md" android:layout_margin="@dimen/spacing_tiny" android:background="@color/dj_border_highlight" />
        <TextView style="@style/DjText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MID" android:textSize="@dimen/text_micro" android:textColor="@color/dj_text_secondary"/>

        <View android:layout_width="@dimen/knob_md" android:layout_height="@dimen/knob_md" android:layout_margin="@dimen/spacing_tiny" android:background="@color/dj_border_highlight" />
        <TextView style="@style/DjText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOW" android:textSize="@dimen/text_micro" android:textColor="@color/dj_text_secondary"/>

        <View android:layout_width="@dimen/knob_md" android:layout_height="@dimen/knob_md" android:layout_margin="@dimen/spacing_tiny" android:background="@color/dj_border_highlight" />
        <TextView style="@style/DjText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FILTER" android:textSize="@dimen/text_micro" android:textColor="@color/dj_text_secondary"/>
    </LinearLayout>

    <!-- Channel Fader Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="@dimen/spacing_medium">

        <!-- VU Meter placeholder -->
        <com.djportablepro.app.ui.mixer.VuMeterView
            android:layout_width="8dp"
            android:layout_height="80dp"
            android:layout_marginEnd="@dimen/spacing_small" />

        <!-- Fader Track -->
        <View
            android:layout_width="4dp"
            android:layout_height="80dp"
            android:background="@color/dj_border" />
    </LinearLayout>

    <Button
        style="@style/DjButton"
        android:layout_width="40dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="CUE"
        android:textSize="@dimen/text_micro" />

</LinearLayout>
